# ==== Painel de Dados Pessoais do LoL — variáveis de ambiente ====
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# Chave da Riot Games (obtida em https://developer.riotgames.com)
# ATENÇÃO: a chave de desenvolvimento expira a cada 24 horas.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Porta do servidor HTTP
PORT=3000

# Região padrão do dropdown. Chaves válidas: BR, NA, LAN, LAS, EUW, EUNE,
# TR, RU, KR, JP, OCE, PH, SG, TH, TW, VN
DEFAULT_REGION=BR

# Quantidade padrão e máxima de partidas analisadas (1..100)
DEFAULT_MATCH_COUNT=20
MAX_MATCH_COUNT=100

# TTL do cache em milissegundos (10 min = 600000)
CACHE_TTL_MS=600000

# Timeout de cada requisição à Riot, em milissegundos
REQUEST_TIMEOUT_MS=15000
